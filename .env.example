# Open DART public disclosures, server-only. Free key from opendart.fss.or.kr.
# Never use a NEXT_PUBLIC prefix. Collector reads .env.development.local on Node 24+.
OPEN_DART_API_KEY=
SEC_USER_AGENT=

# FMP: local evaluation only; never NEXT_PUBLIC. No paid plan is enabled by this flag.
# All-market realtime/display rights are NOT included. Keep off in production.
FMP_API_KEY=
FMP_EVALUATION_ENABLED=false

# Local Google login: copy to .env.development.local (not .env.local).
# Use a separate development project. Never copy live-site credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_DEV_PROJECT_REF=YOUR_DEV_PROJECT_REF
# Leave all three unset for the existing browser-only, no-login local mode.
# Cloudflare builds use the production URL/key only; do not set DEV_PROJECT_REF there.

# Server-only price alert evaluation, from the SAME project as the URL above.
# Keep empty until that project's price-alert migration is applied. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# AdSense: enable after IDs, site approval and private-page crawler access are ready.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_PORTFOLIO_SLOT=
NEXT_PUBLIC_ADSENSE_PORTFOLIO_ENABLED=false
