{
  "name": "centbloom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "market:prepare:company": "node --env-file-if-exists=.env.development.local scripts/prepare-company-data.mjs",
    "dividends:prepare:common": "node --env-file-if-exists=.env.development.local scripts/prepare-common-dividends.mjs",
    "dividends:prepare:dart": "node --env-file-if-exists=.env.development.local scripts/prepare-dart-dividends.mjs",
    "dividends:prepare:foreign": "node --env-file-if-exists=.env.development.local scripts/prepare-foreign-dividends.mjs",
    "dividends:prepare:etf": "node scripts/prepare-etf-dividends.mjs",
    "dividends:prepare": "node --env-file-if-exists=.env.development.local scripts/refresh-dividends.mjs",
    "gurus:prepare": "node scripts/prepare-gurus.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:docs": "node tests/check-docs.mjs",
    "docs:guide": "node tests/check-docs.mjs --guide",
    "check:design": "node tests/check-design.mjs",
    "audit:design": "node tests/check-design.mjs --strict",
    "lint": "node tests/check-docs.mjs && node tests/check-design.mjs && eslint src tests brand scripts *.mjs *.ts",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "prepare": "node tests/install-git-hooks.mjs",
    "hooks:install": "node tests/install-git-hooks.mjs",
    "check:push": "node tests/check-push.mjs",
    "news:prepare": "node scripts/prepare-news.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@supabase/supabase-js": "2.109.0",
    "fflate": "0.8.3",
    "lucide-react": "^1.23.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "saxes": "^6.0.0",
    "yahoo-finance2": "^3.15.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.129.0"
  }
}
