{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "87cf0ec0e51a40a26fe9b98266a8ef16",
  "name": "centbloom",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "centbloom"
    }
  ],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "NEWS_AI",
    "remote": true
  }
}
